# Public values, safe to ship to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Your bot's username, without @ (used for share links and "Open the bot").
VITE_BOT_USERNAME=your_bot

# NEVER add the Telegram bot token here: anything prefixed VITE_ is bundled into
# the public JavaScript. Set it as an Edge Function secret instead (see README).
