index 0000000..fa02e48
--- /dev/null
+++ b/supabase/functions/_shared/telegram.ts
@@ -0,0 +1,109 @@
+// Shared helpers for Edge Functions: Telegram initData verification,
+// HS256 JWT signing, and CORS headers.
+
+export const corsHeaders = {
+  "Access-Control-Allow-Origin": "*",
+  "Access-Control-Allow-Methods": "POST, OPTIONS",
+  "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Client-Info, Apikey",
+};
+
+export function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { ...corsHeaders, "Content-Type": "application/json" },
+  });
+}
+
+const enc = new TextEncoder();
+
+async function hmacSha256(key: Uint8Array, data: string | Uint8Array): Promise<Uint8Array> {
+  const cryptoKey = await crypto.subtle.importKey(
+    "raw",
+    key as BufferSource,
+    { name: "HMAC", hash: "SHA-256" },
+    false,
+    ["sign"],
+  );
+  const payload = typeof data === "string" ? enc.encode(data) : data;
+  return new Uint8Array(await crypto.subtle.sign("HMAC", cryptoKey, payload as BufferSource));
+}
+
+function toHex(bytes: Uint8Array): string {
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+function timingSafeEqual(a: string, b: string): boolean {
+  if (a.length !== b.length) return false;
+  let diff = 0;
+  for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
+  return diff === 0;
+}
+
+export interface VerifiedTelegramUser {
+  id: number;
+  first_name?: string;
+  last_name?: string;
+  username?: string;
+  photo_url?: string;
+}
+
+/**
+ * Verifies Telegram Mini App `initData` as described in
+ * https://core.telegram.org/bots/webapps#validating-data-received-via-the-mini-app
+ * Returns the user only if the HMAC is valid and auth_date is fresh.
+ */
+export async function verifyInitData(
+  initData: string,
+  botToken: string,
+  maxAgeSeconds = 24 * 60 * 60,
+): Promise<VerifiedTelegramUser | null> {
+  if (!initData || !botToken) return null;
+
+  const params = new URLSearchParams(initData);
+  const hash = params.get("hash");
+  if (!hash) return null;
+  params.delete("hash");
+
+  const dataCheckString = [...params.entries()]
+    .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
+    .map(([k, v]) => `${k}=${v}`)
+    .join("\n");
+
+  const secretKey = await hmacSha256(enc.encode("WebAppData"), botToken);
+  const expected = toHex(await hmacSha256(secretKey, dataCheckString));
+  if (!timingSafeEqual(expected, hash.toLowerCase())) return null;
+
+  const authDate = Number(params.get("auth_date"));
+  if (!Number.isFinite(authDate) || authDate <= 0) return null;
+  if (Math.floor(Date.now() / 1000) - authDate > maxAgeSeconds) return null;
+
+  const rawUser = params.get("user");
+  if (!rawUser) return null;
+  try {
+    const user = JSON.parse(rawUser) as VerifiedTelegramUser;
+    if (typeof user.id !== "number") return null;
+    return user;
+  } catch {
+    return null;
+  }
+}
+
+function base64Url(bytes: Uint8Array): string {
+  let binary = "";
+  for (const b of bytes) binary += String.fromCharCode(b);
+  return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+
+/** Signs an HS256 JWT. `secret` must match the project's JWT secret. */
+export async function signJwt(
+  claims: Record<string, unknown>,
+  secret: string,
+  ttlSeconds: number,
+): Promise<{ token: string; expiresAt: number }> {
+  const now = Math.floor(Date.now() / 1000);
+  const exp = now + ttlSeconds;
+  const header = base64Url(enc.encode(JSON.stringify({ alg: "HS256", typ: "JWT" })));
+  const payload = base64Url(enc.encode(JSON.stringify({ ...claims, iat: now, exp })));
+  const signature = base64Url(await hmacSha256(enc.encode(secret), `${header}.${payload}`));
+  return { token: `${header}.${payload}.${signature}`, expiresAt: exp };
+}
diff --git a/supabase/functions/auth-telegram/index.ts b/supabase/functions/auth-telegram/index.ts
new file mode 100644
index 0000000..66830d0
--- /dev/null
+++ b/supabase/functions/auth-telegram/index.ts
@@ -0,0 +1,70 @@
+// Exchanges verified Telegram Mini App initData for a short-lived Supabase JWT.
+// The JWT's `sub` is the users.id of the Telegram user, so RLS policies can use
+// auth.uid() to scope access to the caller's own data.
+//
+// Required secrets (supabase secrets set ...):
+//   TELEGRAM_BOT_TOKEN  - the bot token (never ship it to the browser)
+//   APP_JWT_SECRET      - the project's JWT secret (Settings > API > JWT Secret)
+import { createClient } from "npm:@supabase/supabase-js@2.57.4";
+import { corsHeaders, json, signJwt, verifyInitData } from "../_shared/telegram.ts";
+
+const TOKEN_TTL_SECONDS = 60 * 60;
+
+Deno.serve(async (req: Request) => {
+  if (req.method === "OPTIONS") return new Response(null, { status: 204, headers: corsHeaders });
+  if (req.method !== "POST") return json({ error: "Method not allowed" }, 405);
+
+  const botToken = Deno.env.get("TELEGRAM_BOT_TOKEN");
+  const jwtSecret = Deno.env.get("APP_JWT_SECRET");
+  const supabaseUrl = Deno.env.get("SUPABASE_URL");
+  const serviceRoleKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY");
+  if (!botToken || !jwtSecret || !supabaseUrl || !serviceRoleKey) {
+    console.error("auth-telegram: missing required environment variables");
+    return json({ error: "Server is not configured" }, 500);
+  }
+
+  try {
+    const body = await req.json().catch(() => null);
+    const initData = typeof body?.init_data === "string" ? body.init_data : "";
+
+    const tgUser = await verifyInitData(initData, botToken);
+    if (!tgUser) return json({ error: "Invalid Telegram session" }, 401);
+
+    const supabase = createClient(supabaseUrl, serviceRoleKey, {
+      auth: { persistSession: false, autoRefreshToken: false },
+    });
+
+    // `role` is intentionally not part of the payload, so existing users keep
+    // theirs and new users get the column default ('student').
+    const { data: user, error } = await supabase
+      .from("users")
+      .upsert(
+        {
+          telegram_id: tgUser.id,
+          username: tgUser.username ?? null,
+          first_name: tgUser.first_name ?? "Student",
+          photo_url: tgUser.photo_url ?? null,
+        },
+        { onConflict: "telegram_id" },
+      )
+      .select()
+      .single();
+    if (error || !user) throw error ?? new Error("Could not load user");
+
+    const { token, expiresAt } = await signJwt(
+      {
+        aud: "authenticated",
+        role: "authenticated",
+        sub: user.id,
+        telegram_id: user.telegram_id,
+      },
+      jwtSecret,
+      TOKEN_TTL_SECONDS,
+    );
+
+    return json({ token, expires_at: expiresAt, user });
+  } catch (err) {
+    console.error("auth-telegram error:", err);
+    return json({ error: "Authentication failed" }, 500);
+  }
+});
